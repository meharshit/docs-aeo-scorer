{
  "name": "@aeo-docs-scorer/rubric",
  "version": "0.1.0",
  "description": "Versioned AEO scoring rubric for developer documentation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rubric.json": "./src/rubric.v0.1.json"
  },
  "files": [
    "dist",
    "src/rubric.v0.1.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  }
}

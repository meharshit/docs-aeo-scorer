{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/score", "destination": "/api/score" },
    {
      "source": "/api/public-scores",
      "destination": "/api/public-scores/index"
    },
    {
      "source": "/api/public-scores/",
      "destination": "/api/public-scores/index"
    },
    {
      "source": "/api/public-scores/:path*",
      "destination": "/api/public-scores/:path*"
    },
    { "source": "/scores", "destination": "/index.html" },
    { "source": "/r/:slug", "destination": "/index.html" }
  ]
}
